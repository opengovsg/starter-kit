{
  "name": "@acme/storybook-config",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "format": "oxfmt --ignore-path ../../.gitignore .",
    "lint": "oxlint .",
    "typecheck": "tsrs --noEmit --emitDeclarationOnly false --fast"
  },
  "devDependencies": {
    "@acme/oxlint-config": "workspace:*",
    "@acme/tsconfig": "workspace:*",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "tsrs": "catalog:",
    "typescript": "catalog:"
  }
}
